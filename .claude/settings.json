{
  "permissions": {
    "allow": [
      "Bash(xargs -I{} sh -c 'echo \"{}: $\\(node -p \"require\\(\\\\\"./{}\\\\\"\\).version\"\\)\"')",
      "Bash(sed -i 's|\"@prisma/orm-postgres\": \"\\\\^8.0.0-rc.14\"|\"@prisma/orm-postgres\": \"8.0.0-rc.13\"|' package.json)",
      "Bash(bun install *)",
      "Bash(bunx prisma *)",
      "Bash(PORT=3999 timeout -s INT 8 node dist/main.js)",
      "Bash(echo \"exit: $?\")",
      "Bash(bunx tsc *)",
      "Bash(echo \"tsc exit=$?\")"
    ]
  }
}
